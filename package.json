{
  "name": "bodo-pech-pech",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/protocol.test.ts tests/dialogue.test.ts",
    "test:browser": "npm run build && node --test tests/browser.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "playwright": "1.64.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
